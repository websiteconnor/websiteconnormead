rules_version = '2';

// Firebase Konsolu → Firestore Database → Rules (Kurallar) bölümüne bu metnin TAMAMINI yapıştırıp "Publish" (Yayınla) deyin.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Yönetici: "admins" koleksiyonunda, belge kimliği hesabın UID'si olan bir belge varsa.
    // Yönetici eklemek için README'deki "İlk yöneticiyi ekleme" bölümüne bakın.
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Kişi yalnızca kendi yönetici kaydını okuyabilir (panel açılırken kontrol için).
    // Yazma sadece Firebase Konsolu'ndan yapılır.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Ürün kataloğu, metinler, kargo/ödeme ayarları: herkes okur, yalnızca yönetici yazar.
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Görüntülenme sayısı + puan özeti.
    // Herkes okuyabilir. Görüntülenme için herkes yalnızca +1 yazabilir;
    // puan alanlarını (ratingSum, ratingCount) sadece sunucu işlevi değiştirir.
    match /stats/{pid} {
      allow read: if true;
      allow create: if pid.matches('^[a-z0-9-]{1,60}$')
                    && request.resource.data.keys().hasOnly(['views'])
                    && request.resource.data.views == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                    && request.resource.data.views == (('views' in resource.data ? resource.data.views : 0) + 1);
    }

    // Puanlar: yazma yalnızca sunucu işlevinden (/api/rate) yapılır.
    // Belge kimliği "urunkimligi__uid" biçimindedir; kişi yalnızca kendi puanını okuyabilir.
    match /ratings/{ratingId} {
      allow get: if signedIn() && ratingId.split('__')[1] == request.auth.uid;
      allow list, write: if false;
    }

    // Güvenlik soruları ve cevap özetleri: tarayıcıdan ERİŞİLEMEZ, yalnızca sunucu işlevi kullanır.
    match /security/{uid} {
      allow read, write: if false;
    }

    // Kişinin kendi profili, sepeti ve favorileri.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Siparişler: müşteri kendi siparişini oluşturur ve görür; durumu yalnızca yönetici değiştirir.
    match /orders/{code} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'new'
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 60
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && code.matches('^CM-[A-Z0-9]{6}$');
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
